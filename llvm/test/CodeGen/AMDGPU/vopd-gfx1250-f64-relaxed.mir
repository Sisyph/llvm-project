    ; GFX1200-NEXT: $vgpr6 = V_ADD_F32_e32 killed $vgpr6, killed $vgpr4, implicit $mode, implicit $exec
    ; GFX1200-NEXT: S_ENDPGM 0
    $vgpr4_vgpr5 = V_ADD_F64_pseudo_e32 $vgpr0_vgpr1, $vgpr2_vgpr3, implicit $mode, implicit $exec
    $vgpr6 = V_ADD_F32_e32 $vgpr6, $vgpr4, implicit $mode, implicit $exec
    S_ENDPGM 0

...

