---
name:            test_non_dpmacc_f32_allows_vopd_gfx1250
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3

    ; OpX: V_MUL_F32 (not a DPMACC instruction) writes to vgpr2
    ; OpY: V_ADD_F32 reads from vgpr2
    ; gfx1250: VOPD formation allowed (non-DPMACC, 32-bit)
    ; gfx1200: VOPD formation blocked (no AllowSameVGPR support)
    ; GFX1250-LABEL: name: test_non_dpmacc_f32_allows_vopd_gfx1250
    ; GFX1250: liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: $vgpr3, $vgpr2 = V_DUAL_ADD_F32_e32_X_MUL_F32_e32_gfx1250 killed $vgpr2, $vgpr2, killed $vgpr0, killed $vgpr1, implicit $mode, implicit $exec, implicit $mode, implicit $exec, implicit $mode, implicit $exec
    ; GFX1250-NEXT: S_ENDPGM 0
    ;
    ; GFX1200-LABEL: name: test_non_dpmacc_f32_allows_vopd_gfx1250
    ; GFX1200: liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    ; GFX1200-NEXT: {{  $}}
    ; GFX1200-NEXT: $vgpr3, $vgpr2 = V_DUAL_ADD_F32_e32_X_MUL_F32_e32_gfx12 killed $vgpr2, $vgpr2, killed $vgpr0, killed $vgpr1, implicit $mode, implicit $exec, implicit $mode, implicit $exec, implicit $mode, implicit $exec
    ; GFX1200-NEXT: S_ENDPGM 0
    $vgpr2 = V_MUL_F32_e32 $vgpr0, $vgpr1, implicit $mode, implicit $exec
    $vgpr3 = V_ADD_F32_e32 $vgpr2, $vgpr2, implicit $mode, implicit $exec
    S_ENDPGM 0

...

---
name:            test_fma_f64_no_write_dependency_forms_vopd
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6, $vgpr7

    ; OpX: V_FMA_F64 (DPMACC) writes to vgpr8_vgpr9
    ; OpY: V_ADD_F32 reads from vgpr6 and vgpr7 (no dependency on OpX output)
    ; gfx1250: VOPD formation blocked (64-bit operands in OpX)
    ; gfx1200: VOPD formation blocked (64-bit operands in OpX)
    ; GFX1250-LABEL: name: test_fma_f64_no_write_dependency_forms_vopd
    ; GFX1250: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6, $vgpr7
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: $vgpr8_vgpr9 = V_FMA_F64_e64 0, killed $vgpr0_vgpr1, 0, killed $vgpr2_vgpr3, 0, killed $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
    ; GFX1250-NEXT: $vgpr10 = V_ADD_F32_e32 killed $vgpr6, killed $vgpr7, implicit $mode, implicit $exec
    ; GFX1250-NEXT: S_ENDPGM 0
    ;
    ; GFX1200-LABEL: name: test_fma_f64_no_write_dependency_forms_vopd
    ; GFX1200: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6, $vgpr7
    ; GFX1200-NEXT: {{  $}}
    ; GFX1200-NEXT: $vgpr8_vgpr9 = V_FMA_F64_e64 0, killed $vgpr0_vgpr1, 0, killed $vgpr2_vgpr3, 0, killed $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
    ; GFX1200-NEXT: $vgpr10 = V_ADD_F32_e32 killed $vgpr6, killed $vgpr7, implicit $mode, implicit $exec
    ; GFX1200-NEXT: S_ENDPGM 0
    $vgpr8_vgpr9 = V_FMA_F64_e64 0, $vgpr0_vgpr1, 0, $vgpr2_vgpr3, 0, $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
    $vgpr10 = V_ADD_F32_e32 $vgpr6, $vgpr7, implicit $mode, implicit $exec
    S_ENDPGM 0

...

