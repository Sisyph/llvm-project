# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=postmisched,gcn-create-vopd %s -o - | FileCheck -check-prefix=GFX1250 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=postmisched,gcn-create-vopd %s -o - | FileCheck -check-prefix=GFX1200 %s

# Test multi-cycle VOPD formation constraints
# On gfx1250, when OpX is a DPMACC instruction (multi-cycle) and writes to
# OpY's source registers, VOPD formation is blocked. This applies to:
# V_FMA_F64, V_ADD_F64, V_MUL_F64, V_MAX_NUM_F64, V_MIN_NUM_F64

---
name:            test_fma_f64_dpmacc_constraint
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7

    ; OpX: V_FMA_F64 (DPMACC instruction) writes to vgpr6_vgpr7
    ; OpY: V_ADD_F32 reads from vgpr6
    ; gfx1250: VOPD formation blocked (DPMACC multi-cycle constraint)
    ; gfx1200: VOPD formation blocked (64-bit operands)
    ; GFX1250-LABEL: name: test_fma_f64_dpmacc_constraint
    ; GFX1250: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: $vgpr6_vgpr7 = V_FMA_F64_e64 0, killed $vgpr0_vgpr1, 0, killed $vgpr2_vgpr3, 0, $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
    ; GFX1250-NEXT: $vgpr8 = V_ADD_F32_e32 killed $vgpr5, killed $vgpr7, implicit $mode, implicit $exec
    ; GFX1250-NEXT: S_ENDPGM 0
    ;
    ; GFX1200-LABEL: name: test_fma_f64_dpmacc_constraint
    ; GFX1200: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7
    ; GFX1200-NEXT: {{  $}}
    ; GFX1200-NEXT: $vgpr6_vgpr7 = V_FMA_F64_e64 0, killed $vgpr0_vgpr1, 0, killed $vgpr2_vgpr3, 0, $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
    ; GFX1200-NEXT: $vgpr8 = V_ADD_F32_e32 killed $vgpr5, killed $vgpr7, implicit $mode, implicit $exec
    ; GFX1200-NEXT: S_ENDPGM 0
    $vgpr6_vgpr7 = V_FMA_F64_e64 0, $vgpr0_vgpr1, 0, $vgpr2_vgpr3, 0, $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
    $vgpr8 = V_ADD_F32_e32 $vgpr5, $vgpr7, implicit $mode, implicit $exec
    S_ENDPGM 0

...

---
name:            test_add_f64_dpmacc_constraint
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7

    ; OpX: V_ADD_F64 (DPMACC instruction) writes to vgpr4_vgpr5
    ; OpY: V_ADD_F32 reads from vgpr4
    ; gfx1250: VOPD formation blocked (DPMACC multi-cycle constraint)
    ; gfx1200: VOPD formation blocked (64-bit operands)
    ; GFX1250-LABEL: name: test_add_f64_dpmacc_constraint
    ; GFX1250: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: $vgpr4_vgpr5 = V_ADD_F64_pseudo_e32 killed $vgpr0_vgpr1, killed $vgpr2_vgpr3, implicit $mode, implicit $exec
    ; GFX1250-NEXT: $vgpr6 = V_ADD_F32_e32 killed $vgpr6, killed $vgpr4, implicit $mode, implicit $exec
    ; GFX1250-NEXT: S_ENDPGM 0
    ;
